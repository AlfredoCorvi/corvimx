# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" real al repositorio (ya está en .gitignore).

# Genera una clave nueva con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=coloca-aqui-una-clave-secreta-larga-y-unica

# En producción/exposición con ngrok, deja esto en False
DJANGO_DEBUG=False

# Hosts permitidos, separados por coma. Incluye el dominio de ngrok cuando lo tengas.
# Ejemplo: 127.0.0.1,localhost,abcd-1234.ngrok-free.app
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes confiables para CSRF (deben incluir el esquema https://)
# Ejemplo: https://abcd-1234.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Pon en True solo cuando el sitio se sirva por HTTPS (ngrok usa HTTPS por defecto)
DJANGO_SECURE_SSL_REDIRECT=False
